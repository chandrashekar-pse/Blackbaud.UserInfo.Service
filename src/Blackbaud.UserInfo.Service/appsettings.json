{
	"$schema": "./bin/net8.0/schemas/appsettings.schema.json",
	"Logging": {
		"IncludeScopes": false,
		"LogLevel": {
			"Default": "Information",
			"Blackbaud.IdentityManagement.TokenAuthentication.AspNetCore": "Warning",
			"Microsoft": "Warning",
			"System": "Warning",
			"Azure": "Warning"
		}
	},
	"UseSerilogAppSettings": true,
	"Serilog": {
		"MinimumLevel": "Information"
	},
	"Auth": {
		"Anonymous": {
			"IsEnabled": true
		},
		"BBID": {
			"IsEnabled": true
		},
		"SAS": {
			"IsEnabled": true
		}
	},
	"Swagger": {
		"EnableSKYAPIDoc": true,
		"SaveDocuments": [
			"skyapi"
		]
	},
	"UseProblemJsonErrorResponse": true,
	"ModelValidationExcludeErrors": true,
	"Cosmos": {
		"nos-db": {
			"AccountName": "good-move-cosmos-sql",
			"AccountKey": "pjjOHwIKhTmNmu6WOFtW4dk8gNHHSAC0lLN0Z0PA9N6fn9vEpsYejzDN1pICsDl6Wnc0oagrALqQACDb2w2cVg==",
			"Databases": [
				{
					"DatabaseId": "user-management",
					"Containers": [
						{
							"ContainerId": "user-metadata",
							"PartitionKeyPath": "/EntityId",
							"Throughput": 1000
						}
					]
				}
			]
		}
